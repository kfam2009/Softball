{
  "name": "softball-ndi",
  "version": "0.1.0",
  "private": true,
  "description": "MVP independiente para emitir graficos HTML de Softball como fuentes NDI.",
  "main": "src/electron-main.js",
  "scripts": {
    "start": "node src/server.js",
    "panel": "node src/server.js",
    "control:kiosk": "electron src/panel-main.js",
